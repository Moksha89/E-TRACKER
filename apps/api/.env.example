ENVIRONMENT=development
DATABASE_URL=sqlite:///./cashbook.db
JWT_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated origins (e.g. "https://app.example.com,https://admin.example.com").
# Use "*" only for development; in production, restrict to known origins.
# Mobile clients don't trigger CORS — leave this set to a placeholder if you have no browser client.
CORS_ORIGINS=*

# Phase E — production scale (all optional)
# REDIS_URL=redis://127.0.0.1:6379/0
# SENTRY_DSN=
# LOG_FORMAT=json
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_AUTH=20/minute
# RATE_LIMIT_WRITES=60/minute
