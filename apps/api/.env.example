ENVIRONMENT=development
DATABASE_URL=sqlite:///./cashbook.db
JWT_SECRET=change-me-to-a-long-random-string

# Telegram OTP — pick one channel (Gateway preferred). Leave both empty for dev.
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=

# CORS — comma-separated origins (e.g. "https://app.example.com,https://admin.example.com").
# Use "*" only for development; in production, restrict to known origins.
# Mobile clients don't trigger CORS — leave this set to a placeholder if you have no browser client.
CORS_ORIGINS=*

# OTP — anti-abuse caps
OTP_MAX_REQUESTS_PER_HOUR=5

# Dev-only override: when set, every requested OTP uses this fixed code and
# Telegram delivery is skipped. Leave UNSET in production once the app is
# publicly distributed. Example: OTP_DEV_FIXED_CODE=123456
OTP_DEV_FIXED_CODE=
